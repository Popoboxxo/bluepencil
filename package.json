{
  "name": "bluepencil",
  "version": "0.10.2",
  "description": "Annotate any web app — text and design notes, anchored to the element, readable by humans and agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Popoboxxo/bluepencil.git"
  },
  "homepage": "https://github.com/Popoboxxo/bluepencil#readme",
  "bugs": {
    "url": "https://github.com/Popoboxxo/bluepencil/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "sideEffects": false,
  "main": "./dist/bluepencil.js",
  "module": "./dist/bluepencil.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/bluepencil.js"
    },
    "./data": {
      "types": "./dist/types/data/index.d.ts",
      "import": "./dist/data.js"
    },
    "./adapters/memory": {
      "types": "./dist/types/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./adapters/local-storage": {
      "types": "./dist/types/adapters/local-storage.d.ts",
      "import": "./dist/adapters/local-storage.js"
    },
    "./adapters/chrome-storage": {
      "types": "./dist/types/adapters/chrome-storage.d.ts",
      "import": "./dist/adapters/chrome-storage.js"
    },
    "./adapters/file": {
      "types": "./dist/types/adapters/file.d.ts",
      "import": "./dist/adapters/file.js"
    },
    "./adapters/http": {
      "types": "./dist/types/adapters/http.d.ts",
      "import": "./dist/adapters/http.js"
    },
    "./i18n/en": {
      "types": "./dist/types/i18n/en.d.ts",
      "import": "./dist/i18n/en.js"
    },
    "./i18n/de": {
      "types": "./dist/types/i18n/de.d.ts",
      "import": "./dist/i18n/de.js"
    },
    "./element": {
      "types": "./dist/types/element/index.d.ts",
      "import": "./dist/bluepencil.element.js"
    },
    "./attach": {
      "types": "./dist/types/embed/attach.d.ts",
      "import": "./dist/attach.esm.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bluepencil": "./dist/cli.js",
    "bluepencil-hub": "./dist/server.js",
    "bluepencil-federator": "./dist/federator.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:ext": "tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-guard.mjs",
    "serve": "node dist/server.js",
    "build:ext": "node extension/build.mjs",
    "verify:sync": "node scripts/verify-sync.mjs",
    "check-version-bump": "node scripts/check-version-bump.mjs",
    "smoke:ext": "node extension/smoke.mjs",
    "smoke:webstore": "node scripts/webstore-compliance.mjs",
    "build:site": "node scripts/build-site.mjs",
    "smoke:cli": "node scripts/cli-smoke.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:federation": "node scripts/federation-smoke.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "smoke:install": "node scripts/install-smoke.mjs",
    "smoke:install:git": "node scripts/install-smoke.mjs --only-git",
    "smoke:embed": "node scripts/embed-smoke.mjs",
    "smoke:bookmarklet": "node scripts/bookmarklet-smoke.mjs",
    "smoke:auth": "node scripts/auth-smoke.mjs",
    "smoke:hermes": "node scripts/hermes-wrapper-smoke.mjs",
    "smoke:voice": "node scripts/voice-smoke.mjs",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "smoke:components": "node scripts/components-e2e.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "spec": "python3 scripts/build-reqmd-spec.py",
    "spec:check": "reqmd check spec/",
    "spec:ls": "reqmd ls spec/",
    "spec:stats": "reqmd stats spec/",
    "verify": "npm run typecheck && npm run typecheck:ext && npm run test && npm run build && npm run build:ext && npm run verify:sync && npm run size && npm run smoke:components -- --no-docker",
    "smoke:e2e": "node tests/e2e/vanilla.e2e.mjs",
    "smoke:round-trip": "node tests/e2e/round-trip.e2e.mjs",
    "smoke:parity": "node tests/e2e/parity.e2e.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "annotation",
    "review",
    "feedback",
    "design-review",
    "agents",
    "mcp"
  ]
}
