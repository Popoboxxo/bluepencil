# Copy to `.env` (`cp .env.example .env`) — Compose reads it automatically.
#
# Nothing here is a secret. The two tokens are intentionally empty: Compose fails with
# "BP_DEV_TOKEN is required" instead of starting an aggregate that cannot authenticate.

# Image tag. Pin an exact release for anything long-lived; `latest` is for local experiments only.
BLUEPENCIL_IMAGE=ghcr.io/popoboxxo/bluepencil:0.10.3

# Host ports: the two leaves are the browser-facing hubs, the aggregator is loopback-only.
BLUEPENCIL_DEV_PORT=8787
BLUEPENCIL_STAGING_PORT=8788
BLUEPENCIL_AGGREGATOR_PORT=8790

# Container names.
BLUEPENCIL_DEV_NAME=bluepencil-hub-dev
BLUEPENCIL_STAGING_NAME=bluepencil-hub-staging
BLUEPENCIL_AGGREGATOR_NAME=bluepencil-hub-aggregator

# Docker network name, also used by the federator one-liner in docker-compose.yml.
BLUEPENCIL_NETWORK=bluepencil-federation

# uid/gid the aggregator runs as. The registry file must be 0600 and owned by exactly this user;
# the image's `node` user is 1000. Set these to `id -u`/`id -g` if your host user differs (then let
# that user own instances.json instead of chowning it to 1000).
BLUEPENCIL_UID=1000
BLUEPENCIL_GID=1000

# Required. These are the leaves' shared secrets AND the variables the registry references via
# `auth: {"env": "…"}`. Use high-entropy values, e.g. `openssl rand -hex 32`. Do not commit them.
# BP_DEV_TOKEN=
# BP_STAGING_TOKEN=
