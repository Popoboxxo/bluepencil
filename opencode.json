{
  "experimental": {
    "subagent_depth": 3
  },
  "mcp": {
    "viz-logger": {
      "type": "local",
      "enabled": true,
      "command": [
        "python3",
        "scripts/viz-logger.py",
        "--mcp"
      ]
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "**": "deny"
    },
    "bash": {
      "**": "deny"
    }
  },
  "default_agent": "orchestrator"
}
